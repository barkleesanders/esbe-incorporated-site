{
  "name": "esbe-incorporated-site",
  "main": "index.js",
  "compatibility_date": "2026-09-22",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "routes": [
    { "pattern": "esbeincorporated.org", "custom_domain": true },
    { "pattern": "www.esbeincorporated.org", "custom_domain": true }
  ],
  "observability": { "enabled": true, "logs": { "enabled": true, "persist": true, "invocation_logs": true } }
}
